polygon(c(rep(c(0:10),each=2)), c(5.2,rep(p2_2nd$resp_symp+5.2,each=2),5.2), col=gray(0.7),lty=0)
axis(4, at=0:5+5.2,las=1,labels=0:5)
mtext("Number of
symptoms
