case)", side=4,line=3,cex=0.8,at=7.7,las=1)
lines(c(0,11.8),c(5.2,5.2))
lines(c(0,11.8),c(0,0))
lines(type= "p", c(0,4,7,11)+0.5, rep(10.8,4),lty=1,cex=1.2, pch=c("-","-","+",NA))
lines(c(4,4,7,7)+0.5,c(10.2,10.5,10.5,10.2))
